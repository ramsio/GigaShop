<%- include('../partials/header') %>
<div style="padding:20px; max-width:900px; margin:20px auto;">
    <h2>Mi Carrito y Pedidos</h2>

    <% const pendientes = compras.filter(c => c.estado === 'pendiente_pago'); %>

    <% if (pendientes.length > 0) { %>
        <div style="background:#fff3cd; padding:12px; margin-bottom:18px; border-radius:6px;">
            <h3>🛒 Pendientes de Pago</h3>
            <ul>
                <% pendientes.forEach(item => { %>
                    <li><%= item.producto.nombre %> - <%= config.moneda %><%= Number(item.producto.precio).toFixed(2) %></li>
                <% }) %>
            </ul>
            <a href="/pagar"><button style="background:green; color:white; padding:10px; border:none; border-radius:4px; cursor:pointer;">IR A PAGAR TODO</button></a>
        </div>
    <% } %>

    <h3>📦 Historial de Compras</h3>
    <table border="1" width="100%" cellpadding="8" style="border-collapse:collapse;">
        <tr><th>Producto</th><th>Estado</th><th>Acción</th></tr>
        <% compras.forEach(item => { %>
            <% if(item.estado !== 'pendiente_pago') { %>
                <tr>
                    <td><%= item.producto.nombre %></td>
                    <td>
                        <% if(item.estado === 'pendiente_retiro') { %>
                            <span style="color:blue;">✅ Listo para retirar</span>
                        <% } else { %>
                            <span style="color:red;">Cancelado</span>
                        <% } %>
                    </td>
                    <td>
                        <% if(item.estado === 'pendiente_retiro') { %>
                            <a href="/cancelar-compra/<%= item.id_compra %>" style="color:red;">Cancelar Compra</a>
                        <% } %>
                    </td>
                </tr>
            <% } %>
        <% }) %>
    </table>
</div>
<%- include('../partials/footer') %>
